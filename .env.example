# Core app settings
# Optional PostgreSQL URL. If unset, local development uses SQLite.
DATABASE_URL=
GEMINI_API_KEY=
# Use the Gemini Developer API model ID.
GEMINI_MODEL_NAME=gemini-3.5-flash-lite
# Leave empty for Google's API; custom URLs must implement the native Gemini API.
GEMINI_BASE_URL=

# Optional ExchangeRate-API key. When absent, the free no-key endpoint is used.
EXCHANGE_RATE_API_KEY=

# Optional Auth0 settings
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_AUDIENCE=
# Dedicated Auth0 M2M app with read:users, update:users, create:users, and delete:users grants
AUTH0_MANAGEMENT_CLIENT_ID=
AUTH0_MANAGEMENT_CLIENT_SECRET=

# Optional Langfuse settings
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
